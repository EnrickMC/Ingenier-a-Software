# =====================================================================
# Variables de ApiCARMIR en la EC2 de AWS
# Copia este contenido en /opt/carmir/api.env (en la EC2, NO en Git) y cambia las contraseñas.
#   chmod 600 /opt/carmir/api.env
# =====================================================================
NODE_ENV=production

# --- Servidor ---
# 0.0.0.0 = acepta conexiones de CloudFront (el grupo de seguridad carmir-api-sg solo deja pasar a CloudFront)
API_HOST=0.0.0.0
API_PUERTO=3000
# Dominio de la página (CloudFront). Si se agrega un dominio propio, se pone también aquí separado por coma.
CORS_ORIGENES=https://d3vsfgax7m05ih.cloudfront.net
LIMITE_PETICIONES_MINUTO=300
LIMITE_PEDIDOS_HORA=10
# CloudFront está entre el cliente y la API: se confía en 1 proxy para leer la IP real del cliente
PROXIES_CONFIABLES=1

# --- Base de datos en Amazon RDS ---
DB_HOST=basecarmir.clsq6iea8ubs.us-east-2.rds.amazonaws.com
DB_PUERTO=3306
DB_NOMBRE=CARMIR_DB
# Certificado de RDS (lo descarga instalar_en_ec2.sh). Sin él RDS rechaza la conexión.
DB_SSL_CA=/opt/carmir/global-bundle.pem
# Usuario de solo lectura (paso 7)
DB_USUARIO=carmir_web
DB_CONTRASENA=escribe_aqui_la_contrasena
DB_CONEXIONES_MAXIMAS=10
DB_TIEMPO_ESPERA_MS=10000

# --- Usuario que guarda los pedidos (paso 7 + DBCarmir/aws/PERMISOS_RDS.sql) ---
DB_ESCRITURA_USUARIO=carmir_pedidos
DB_ESCRITURA_CONTRASENA=escribe_aqui_la_contrasena
