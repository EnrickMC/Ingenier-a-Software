# =====================================================================
# Configuración de la API de CARMIR
# 1. Copia este archivo y nómbralo ".env" (en esta misma carpeta ApiCARMIR).
# 2. Escribe tus datos reales en el .env. El .env NO se sube a Git.
# =====================================================================

# --- Servidor de la API ---
# 127.0.0.1 = la API solo acepta conexiones de esta misma computadora
API_HOST=127.0.0.1
API_PUERTO=3000
# Páginas que pueden llamar a la API desde el navegador (separadas por coma)
CORS_ORIGENES=http://localhost:4200
LIMITE_PETICIONES_MINUTO=300
# Pedidos que se pueden registrar por hora desde la misma conexión (Módulo 2)
LIMITE_PEDIDOS_HORA=10

# --- Base de datos MySQL ---
DB_HOST=127.0.0.1
DB_PUERTO=3306
DB_NOMBRE=CARMIR_DB
# Recomendado: el usuario de solo lectura que crea sql/crear_usuario_lectura.sql
# (en tu computadora también funciona con root)
DB_USUARIO=root
DB_CONTRASENA=admin
DB_CONEXIONES_MAXIMAS=10
DB_TIEMPO_ESPERA_MS=10000

# --- Módulo 2 · Portal de Pedidos: usuario que GUARDA pedidos ---
# Lo crea sql/crear_usuario_pedidos.sql (solo puede agregar pedidos, no borrar ni cambiar nada).
# Si lo dejas vacío, el catálogo funciona pero no se pueden enviar pedidos.
DB_ESCRITURA_USUARIO=carmir_pedidos
DB_ESCRITURA_CONTRASENA=escribe_aqui_la_contrasena
