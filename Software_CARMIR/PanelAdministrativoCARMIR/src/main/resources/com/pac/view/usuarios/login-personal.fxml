<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Inicio de sesión del Personal (diseño de Personal.html) -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pac.modulos.usuarios.controller.LoginPersonalController"
           styleClass="fondo-login"
           stylesheets="@../../css/carmir-base.css, @../../css/login.css">

    <VBox styleClass="login-box" maxWidth="350" prefWidth="350" maxHeight="-Infinity">
        <VBox styleClass="login-header" alignment="CENTER" spacing="8">
            <StackPane styleClass="login-header-icono">
                <FontIcon iconLiteral="bi-person-fill"/>
            </StackPane>
            <Label styleClass="login-header-titulo" text="CARMIR"/>
            <Label styleClass="login-header-sub" text="Acceso del Personal"/>
        </VBox>

        <VBox styleClass="login-body" spacing="8">
            <Label styleClass="login-label" text="Usuario:" maxWidth="Infinity" alignment="CENTER"/>
            <TextField fx:id="txtUsuario" styleClass="campo" alignment="CENTER"
                       promptText="Ingresa tu usuario"/>

            <Label styleClass="login-label" text="Contraseña:" maxWidth="Infinity" alignment="CENTER">
                <VBox.margin><Insets top="12"/></VBox.margin>
            </Label>
            <PasswordField fx:id="pwdContrasena" styleClass="campo" alignment="CENTER"
                           promptText="Ingresa contraseña" onAction="#onIngresar"/>

            <Label fx:id="lblMensaje" styleClass="mensaje-error" maxWidth="Infinity">
                <graphic><FontIcon iconLiteral="bi-exclamation-triangle-fill" iconColor="#c0392b"/></graphic>
            </Label>

            <Button fx:id="btnIngresar" text="Ingresar" styleClass="btn-verde, btn-ingresar"
                    maxWidth="Infinity" defaultButton="true" onAction="#onIngresar">
                <graphic><FontIcon iconLiteral="bi-box-arrow-in-right"/></graphic>
                <VBox.margin><Insets top="14"/></VBox.margin>
            </Button>
        </VBox>

        <VBox styleClass="login-footer" alignment="CENTER" spacing="4">
            <Hyperlink styleClass="enlace" text="Volver a la pantalla de bloqueo"
                       onAction="#onVolverABloqueo">
                <graphic><FontIcon iconLiteral="bi-arrow-left"/></graphic>
            </Hyperlink>
            <Label fx:id="lblNegocio" styleClass="login-footer-texto" text="Delicias de Postres"/>
        </VBox>
    </VBox>
</StackPane>
