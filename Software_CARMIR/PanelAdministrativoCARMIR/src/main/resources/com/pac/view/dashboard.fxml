<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Dashboard principal (estructura de MenuAdmin.html) -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pac.controller.DashboardController" spacing="30"
      stylesheets="@../css/usuarios.css">

    <!-- Tarjetas de resumen -->
    <HBox spacing="20">
        <VBox styleClass="kpi-card" spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label styleClass="kpi-titulo" text="PEDIDOS DE HOY" graphicTextGap="8">
                <graphic><FontIcon iconLiteral="bi-basket-fill"/></graphic>
            </Label>
            <Label fx:id="lblPedidosHoy" styleClass="kpi-valor" text="—"/>
            <Label fx:id="lblDetallePedidos" styleClass="kpi-detalle" text=""/>
        </VBox>
        <VBox styleClass="kpi-card, ingresos" spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label styleClass="kpi-titulo" text="INGRESOS DEL MES" graphicTextGap="8">
                <graphic><FontIcon iconLiteral="bi-cash-stack"/></graphic>
            </Label>
            <Label fx:id="lblIngresos" styleClass="kpi-valor" text="—"/>
            <Label fx:id="lblDetalleIngresos" styleClass="kpi-detalle" text=""/>
        </VBox>
        <VBox styleClass="kpi-card, alerta" spacing="10" HBox.hgrow="ALWAYS" maxWidth="Infinity">
            <Label styleClass="kpi-titulo" text="ALERTAS DE INVENTARIO" graphicTextGap="8">
                <graphic><FontIcon iconLiteral="bi-exclamation-triangle-fill"/></graphic>
            </Label>
            <Label fx:id="lblAlertas" styleClass="kpi-valor" text="—"/>
            <Label fx:id="lblDetalleAlertas" styleClass="kpi-detalle" text=""/>
        </VBox>
    </HBox>

    <!-- Tabla de últimos pedidos (Módulo 4); doble clic abre el pedido en Gestión de Pedidos -->
    <VBox styleClass="tarjeta" spacing="16" VBox.vgrow="ALWAYS">
        <Label styleClass="tarjeta-titulo" text="Últimos Pedidos Entrantes (Web)"/>
        <TableView fx:id="tblPedidos" styleClass="tabla-carmir" VBox.vgrow="ALWAYS" minHeight="220"
                   onMouseClicked="#onClicPedidos">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <columns>
                <TableColumn text="ID Pedido" prefWidth="80">
                    <cellValueFactory><PropertyValueFactory property="folio"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Cliente" prefWidth="160">
                    <cellValueFactory><PropertyValueFactory property="cliente"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Productos" prefWidth="260">
                    <cellValueFactory><PropertyValueFactory property="productos"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Total" prefWidth="90">
                    <cellValueFactory><PropertyValueFactory property="total"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Entrega" prefWidth="90">
                    <cellValueFactory><PropertyValueFactory property="entrega"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Estado" prefWidth="160">
                    <cellValueFactory><PropertyValueFactory property="estado"/></cellValueFactory>
                </TableColumn>
            </columns>
            <placeholder>
                <Label fx:id="lblSinPedidos" styleClass="tabla-vacia" text="No hay pedidos activos"/>
            </placeholder>
        </TableView>
        <Label fx:id="lblAyudaPedidos" styleClass="texto-ayuda" text="Doble clic en un pedido para abrirlo en Gestión de Pedidos."/>
    </VBox>
</VBox>
