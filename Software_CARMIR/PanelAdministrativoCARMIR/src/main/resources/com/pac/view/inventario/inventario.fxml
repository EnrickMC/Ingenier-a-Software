<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Módulo 5 · Inventario de Insumos: insumos, lotes y movimientos, y alertas -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pac.modulos.inventario.controller.InventarioController"
      stylesheets="@../../css/usuarios.css, @../../css/catalogo.css, @../../css/inventario.css" spacing="14">

    <!-- Aviso para el personal que solo puede consultar los datos de los insumos -->
    <Label fx:id="lblModoConsulta" styleClass="aviso-consulta" maxWidth="Infinity" wrapText="true"
           text="Puedes registrar compras y mermas. Solo la administradora registra, modifica o da de baja insumos.">
        <graphic><FontIcon iconLiteral="bi-eye-fill"/></graphic>
    </Label>

    <TabPane fx:id="pestanas" styleClass="pestanas-catalogo" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <Tab fx:id="tabInsumos" text="Insumos" onSelectionChanged="#onCambioPestana">
            <graphic><FontIcon iconLiteral="bi-box-seam"/></graphic>
            <content><fx:include fx:id="insumos" source="insumos.fxml"/></content>
        </Tab>
        <Tab fx:id="tabMovimientos" text="Lotes y movimientos" onSelectionChanged="#onCambioPestana">
            <graphic><FontIcon iconLiteral="bi-arrow-left-right"/></graphic>
            <content><fx:include fx:id="movimientos" source="movimientos.fxml"/></content>
        </Tab>
        <Tab fx:id="tabAlertas" text="Alertas" onSelectionChanged="#onCambioPestana">
            <graphic><FontIcon iconLiteral="bi-exclamation-triangle-fill"/></graphic>
            <content><fx:include fx:id="alertas" source="alertas.fxml"/></content>
        </Tab>
    </TabPane>
</VBox>
