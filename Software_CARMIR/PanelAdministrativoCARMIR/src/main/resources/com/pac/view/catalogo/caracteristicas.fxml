<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Pestaña Características: las que el cliente personaliza en cada categoría -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pac.modulos.catalogo.controller.CaracteristicasController"
      styleClass="pestana-contenido" spacing="16">

    <HBox styleClass="tarjeta" spacing="12" alignment="CENTER_LEFT">
        <Label styleClass="formulario-etiqueta" text="Categoría"/>
        <ComboBox fx:id="cmbCategoria" styleClass="combo-carmir" prefWidth="240" onAction="#onCambioCategoria"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnNueva" text="Nueva característica" styleClass="btn-verde" onAction="#onNueva">
            <graphic><FontIcon iconLiteral="bi-plus-circle-fill"/></graphic>
        </Button>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox styleClass="tarjeta" spacing="12" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="tarjeta-titulo" text="Características (en el orden en que las ve el cliente)"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblConteo" styleClass="texto-suave"/>
            </HBox>
            <TableView fx:id="tblCaracteristicas" styleClass="tabla-carmir" VBox.vgrow="ALWAYS" minHeight="260"
                       onMouseClicked="#onClicTabla" onKeyReleased="#onTeclaTabla">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <columns>
                    <TableColumn text="Orden" minWidth="55" prefWidth="55">
                        <cellValueFactory><PropertyValueFactory property="orden"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Nombre" minWidth="130" prefWidth="130">
                        <cellValueFactory><PropertyValueFactory property="nombre"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Selección" minWidth="80" prefWidth="80">
                        <cellValueFactory><PropertyValueFactory property="seleccion"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Obligatoria" minWidth="80" prefWidth="80">
                        <cellValueFactory><PropertyValueFactory property="obligatoria"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Presupuesto" minWidth="90" prefWidth="90">
                        <cellValueFactory><PropertyValueFactory property="presupuesto"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Disponible" minWidth="80" prefWidth="80">
                        <cellValueFactory><PropertyValueFactory property="disponible"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Opciones" minWidth="70" prefWidth="70">
                        <cellValueFactory><PropertyValueFactory property="opciones"/></cellValueFactory>
                    </TableColumn>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="12">
                        <Label fx:id="lblVacio" styleClass="tabla-vacia" text="Elige una categoría"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>

        <VBox styleClass="tarjeta, tarjeta-detalle" spacing="12" minWidth="290" prefWidth="290" maxWidth="290">
            <Label styleClass="tarjeta-titulo" text="Detalle"/>
            <VBox fx:id="cajaSinSeleccion" alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
                <FontIcon iconLiteral="bi-sliders" styleClass="detalle-icono-vacio"/>
                <Label styleClass="texto-suave" wrapText="true" textAlignment="CENTER"
                       text="Selecciona una característica para ver sus reglas y opciones"/>
            </VBox>
            <VBox fx:id="cajaDetalle" spacing="10" VBox.vgrow="ALWAYS">
                <Label fx:id="lblDetNombre" styleClass="detalle-nombre" wrapText="true"/>
                <Label fx:id="lblDetDescripcion" styleClass="texto-suave" wrapText="true"/>
                <Label fx:id="lblDetReglas" wrapText="true"/>
                <Separator/>
                <Label styleClass="detalle-etiqueta" text="Opciones"/>
                <VBox fx:id="listaOpciones" spacing="4"/>
                <Region VBox.vgrow="ALWAYS"/>
                <HBox fx:id="cajaOrden" spacing="8">
                    <Button text="Subir" styleClass="btn-oscuro" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onSubir">
                        <graphic><FontIcon iconLiteral="bi-arrow-up"/></graphic>
                    </Button>
                    <Button text="Bajar" styleClass="btn-oscuro" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onBajar">
                        <graphic><FontIcon iconLiteral="bi-arrow-down"/></graphic>
                    </Button>
                </HBox>
                <Button text="Ver opciones" styleClass="btn-oscuro" maxWidth="Infinity" onAction="#onVerOpciones">
                    <graphic><FontIcon iconLiteral="bi-list-check"/></graphic>
                </Button>
                <Button fx:id="btnModificar" text="Modificar característica" styleClass="btn-azul" maxWidth="Infinity" onAction="#onModificar">
                    <graphic><FontIcon iconLiteral="bi-pencil-square"/></graphic>
                </Button>
                <Button fx:id="btnDarDeBaja" text="Dar de baja" styleClass="btn-rojo" maxWidth="Infinity" onAction="#onDarDeBaja">
                    <graphic><FontIcon iconLiteral="bi-trash-fill"/></graphic>
                </Button>
            </VBox>
        </VBox>
    </HBox>
</VBox>
