<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Pestaña Opciones: valores que el cliente elige dentro de cada característica -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pac.modulos.catalogo.controller.OpcionesController"
      styleClass="pestana-contenido" spacing="16">

    <HBox styleClass="tarjeta" spacing="10" alignment="CENTER_LEFT">
        <ComboBox fx:id="cmbCategoria" styleClass="combo-carmir" prefWidth="170" promptText="Categoría"
                  onAction="#onCambioCategoria"/>
        <ComboBox fx:id="cmbCaracteristica" styleClass="combo-carmir" prefWidth="180" promptText="Característica"
                  onAction="#onCambioCaracteristica"/>
        <TextField fx:id="txtBuscar" styleClass="campo, campo-busqueda" HBox.hgrow="ALWAYS" maxWidth="220"
                   promptText="Buscar opción" onAction="#onBuscar"/>
        <Button text="Buscar" minWidth="-Infinity" styleClass="btn-oscuro" onAction="#onBuscar">
            <graphic><FontIcon iconLiteral="bi-zoom-in"/></graphic>
        </Button>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnNueva" text="Nueva opción" minWidth="-Infinity" styleClass="btn-verde" onAction="#onNueva">
            <graphic><FontIcon iconLiteral="bi-plus-circle-fill"/></graphic>
        </Button>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox styleClass="tarjeta" spacing="12" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="tarjeta-titulo" text="Opciones de la característica"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblConteo" styleClass="texto-suave"/>
            </HBox>
            <Label fx:id="lblAviso" styleClass="aviso-amarillo" maxWidth="Infinity" wrapText="true">
                <graphic><FontIcon iconLiteral="bi-exclamation-triangle-fill"/></graphic>
            </Label>
            <TableView fx:id="tblOpciones" styleClass="tabla-carmir" VBox.vgrow="ALWAYS" minHeight="260"
                       onMouseClicked="#onClicTabla" onKeyReleased="#onTeclaTabla">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <columns>
                    <TableColumn text="Nombre" minWidth="120" prefWidth="120">
                        <cellValueFactory><PropertyValueFactory property="nombre"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Mult. ingredientes" minWidth="80" prefWidth="80">
                        <cellValueFactory><PropertyValueFactory property="multIngredientes"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Mult. costo" minWidth="70" prefWidth="70">
                        <cellValueFactory><PropertyValueFactory property="multCosto"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Se escala" minWidth="60" prefWidth="60">
                        <cellValueFactory><PropertyValueFactory property="seEscala"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Puntos" minWidth="55" prefWidth="55">
                        <cellValueFactory><PropertyValueFactory property="puntos"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Mult. presupuesto" minWidth="80" prefWidth="80">
                        <cellValueFactory><PropertyValueFactory property="multPresupuesto"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Disponible" minWidth="65" prefWidth="65">
                        <cellValueFactory><PropertyValueFactory property="disponible"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Costo receta" minWidth="80" prefWidth="80">
                        <cellValueFactory><PropertyValueFactory property="costoReceta"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Precio base" minWidth="80" prefWidth="80">
                        <cellValueFactory><PropertyValueFactory property="precioBase"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Exclusiones" minWidth="70" prefWidth="70">
                        <cellValueFactory><PropertyValueFactory property="exclusiones"/></cellValueFactory>
                    </TableColumn>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="12">
                        <Label fx:id="lblVacio" styleClass="tabla-vacia" text="Elige una característica"/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>

        <VBox styleClass="tarjeta, tarjeta-detalle" spacing="10" minWidth="290" prefWidth="290" maxWidth="290">
            <Label styleClass="tarjeta-titulo" text="Detalle"/>
            <VBox fx:id="cajaSinSeleccion" alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
                <FontIcon iconLiteral="bi-list-check" styleClass="detalle-icono-vacio"/>
                <Label styleClass="texto-suave" wrapText="true" textAlignment="CENTER"
                       text="Selecciona una opción para ver su detalle y sus exclusiones"/>
            </VBox>
            <ScrollPane fx:id="cajaDetalle" fitToWidth="true" styleClass="scroll-detalle" VBox.vgrow="ALWAYS">
                <VBox spacing="10">
                    <Label fx:id="lblDetNombre" styleClass="detalle-nombre" wrapText="true"/>
                    <Label fx:id="lblDetDescripcion" styleClass="texto-suave" wrapText="true"/>
                    <VBox styleClass="caja-imagen" alignment="CENTER" minHeight="120">
                        <ImageView fx:id="imgOpcion" fitWidth="240" fitHeight="120" preserveRatio="true"/>
                        <Label fx:id="lblSinImagen" styleClass="texto-suave" text="Sin imagen">
                            <graphic><FontIcon iconLiteral="bi-image-fill"/></graphic>
                        </Label>
                    </VBox>
                    <Label fx:id="lblDetValores" wrapText="true"/>
                    <Separator/>
                    <Label styleClass="detalle-etiqueta" text="Exclusiones"/>
                    <VBox fx:id="listaExclusiones" spacing="4"/>
                </VBox>
            </ScrollPane>
            <VBox fx:id="cajaBotones" spacing="8">
                <Button fx:id="btnReceta" text="Ver receta" styleClass="btn-verde" maxWidth="Infinity" onAction="#onReceta">
                    <graphic><FontIcon iconLiteral="bi-journal-bookmark-fill"/></graphic>
                </Button>
                <Button fx:id="btnExclusiones" text="Administrar exclusiones" styleClass="btn-oscuro" maxWidth="Infinity" onAction="#onExclusiones">
                    <graphic><FontIcon iconLiteral="bi-slash-circle-fill"/></graphic>
                </Button>
                <Button fx:id="btnModificar" text="Modificar opción" styleClass="btn-azul" maxWidth="Infinity" onAction="#onModificar">
                    <graphic><FontIcon iconLiteral="bi-pencil-square"/></graphic>
                </Button>
                <Button fx:id="btnDarDeBaja" text="Dar de baja" styleClass="btn-rojo" maxWidth="Infinity" onAction="#onDarDeBaja">
                    <graphic><FontIcon iconLiteral="bi-trash-fill"/></graphic>
                </Button>
            </VBox>
        </VBox>
    </HBox>
</VBox>
