<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Pestaña Productos (RF-28 a RF-31) -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pac.modulos.catalogo.controller.ProductosController"
      styleClass="pestana-contenido" spacing="16">

    <HBox styleClass="tarjeta" spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar" styleClass="campo, campo-busqueda" HBox.hgrow="ALWAYS" maxWidth="260"
                   promptText="Buscar por nombre o SKU" onAction="#onBuscar"/>
        <ComboBox fx:id="cmbCategoria" styleClass="combo-carmir" prefWidth="170" onAction="#onBuscar"/>
        <ComboBox fx:id="cmbVisibilidad" styleClass="combo-carmir" prefWidth="140" onAction="#onBuscar"/>
        <Button text="Buscar" minWidth="-Infinity" styleClass="btn-oscuro" onAction="#onBuscar">
            <graphic><FontIcon iconLiteral="bi-zoom-in"/></graphic>
        </Button>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnNuevo" text="Nuevo Postre" minWidth="-Infinity" styleClass="btn-verde" onAction="#onNuevo">
            <graphic><FontIcon iconLiteral="bi-plus-circle-fill"/></graphic>
        </Button>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox styleClass="tarjeta" spacing="12" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="tarjeta-titulo" text="Productos del catálogo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblConteo" styleClass="texto-suave"/>
                <!-- Cambia entre ver los productos en tabla o en cuadrícula (imagen arriba, datos abajo) -->
                <Button fx:id="btnVistaTabla" styleClass="btn-vista, btn-vista-izq" onAction="#onVistaTabla">
                    <graphic><FontIcon iconLiteral="bi-table"/></graphic>
                </Button>
                <Button fx:id="btnVistaCuadricula" styleClass="btn-vista, btn-vista-der" onAction="#onVistaCuadricula">
                    <graphic><FontIcon iconLiteral="bi-grid-3x3-gap-fill"/></graphic>
                </Button>
            </HBox>
            <StackPane VBox.vgrow="ALWAYS" minHeight="260">
            <ScrollPane fx:id="scrollTiles" fitToWidth="true" styleClass="scroll-tiles" hbarPolicy="NEVER">
                <FlowPane fx:id="flujoTiles" styleClass="flujo-tiles" hgap="14" vgap="14"/>
            </ScrollPane>
            <TableView fx:id="tblProductos" styleClass="tabla-carmir" minHeight="260"
                       onMouseClicked="#onClicTabla" onKeyReleased="#onTeclaTabla">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <columns>
                    <TableColumn text="SKU" minWidth="80" prefWidth="80">
                        <cellValueFactory><PropertyValueFactory property="sku"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Nombre" minWidth="170" prefWidth="170">
                        <cellValueFactory><PropertyValueFactory property="nombre"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Categoría" minWidth="110" prefWidth="110">
                        <cellValueFactory><PropertyValueFactory property="categoria"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Precio" minWidth="85" prefWidth="85">
                        <cellValueFactory><PropertyValueFactory property="precio"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Costo" minWidth="80" prefWidth="80">
                        <cellValueFactory><PropertyValueFactory property="costo"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Tienda web" minWidth="80" prefWidth="80">
                        <cellValueFactory><PropertyValueFactory property="enTienda"/></cellValueFactory>
                    </TableColumn>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="12">
                        <Label fx:id="lblVacio" styleClass="tabla-vacia" text="Cargando productos..."/>
                    </VBox>
                </placeholder>
            </TableView>
            </StackPane>
        </VBox>

        <!-- ===== Ficha del producto ===== -->
        <VBox styleClass="tarjeta, tarjeta-detalle" spacing="10" minWidth="300" prefWidth="300" maxWidth="300">
            <Label styleClass="tarjeta-titulo" text="Ficha del producto"/>
            <VBox fx:id="cajaSinSeleccion" alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
                <FontIcon iconLiteral="bi-gift-fill" styleClass="detalle-icono-vacio"/>
                <Label styleClass="texto-suave" wrapText="true" textAlignment="CENTER"
                       text="Selecciona un producto para ver su ficha completa"/>
            </VBox>
            <ScrollPane fx:id="cajaDetalle" fitToWidth="true" styleClass="scroll-detalle" VBox.vgrow="ALWAYS">
                <VBox spacing="10">
                    <VBox styleClass="caja-imagen" alignment="CENTER" minHeight="150">
                        <ImageView fx:id="imgProducto" fitWidth="250" fitHeight="150" preserveRatio="true"/>
                        <Label fx:id="lblSinImagen" styleClass="texto-suave" text="Sin imagen">
                            <graphic><FontIcon iconLiteral="bi-image-fill"/></graphic>
                        </Label>
                    </VBox>
                    <Label fx:id="lblDetNombre" styleClass="detalle-nombre" wrapText="true"/>
                    <GridPane hgap="10" vgap="6">
                        <columnConstraints>
                            <ColumnConstraints minWidth="90"/>
                            <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>
                        <Label styleClass="detalle-etiqueta" text="SKU" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDetSku" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label styleClass="detalle-etiqueta" text="Categoría" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDetCategoria" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label styleClass="detalle-etiqueta" text="Precio base" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDetPrecio" styleClass="precio" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label styleClass="detalle-etiqueta" text="Costo" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDetCosto" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label styleClass="detalle-etiqueta" text="Tienda web" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <Label fx:id="lblDetTienda" styleClass="estado-chip" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    </GridPane>
                    <Label fx:id="lblDetIncompletos" styleClass="aviso-amarillo" maxWidth="Infinity" wrapText="true">
                        <graphic><FontIcon iconLiteral="bi-exclamation-triangle-fill"/></graphic>
                    </Label>
                    <Label fx:id="lblDetDescripcion" styleClass="texto-suave" wrapText="true"/>
                    <Separator/>
                    <Label styleClass="detalle-etiqueta" text="Opciones que lo forman"/>
                    <VBox fx:id="listaOpciones" spacing="4"/>
                </VBox>
            </ScrollPane>
            <VBox fx:id="cajaBotones" spacing="8">
                <Button fx:id="btnEditar" text="Editar detalles" styleClass="btn-azul" maxWidth="Infinity" onAction="#onEditar">
                    <graphic><FontIcon iconLiteral="bi-pencil-square"/></graphic>
                </Button>
                <Button fx:id="btnDarDeBaja" text="Dar de baja" styleClass="btn-rojo" maxWidth="Infinity" onAction="#onDarDeBaja">
                    <graphic><FontIcon iconLiteral="bi-trash-fill"/></graphic>
                </Button>
            </VBox>
        </VBox>
    </HBox>
</VBox>
