<?xml version="1.0" encoding="UTF-8"?>

<?import com.pac.util.IconoAyuda?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Ventana para registrar (RF-16) o modificar (RF-17) una categoría -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pac.modulos.catalogo.controller.FormularioCategoriaController"
      stylesheets="@../../css/carmir-base.css, @../../css/usuarios.css, @../../css/catalogo.css"
      styleClass="formulario" spacing="14" prefWidth="480">

    <VBox spacing="2">
        <Label fx:id="lblTitulo" styleClass="formulario-titulo" text="Nueva categoría"/>
        <Label fx:id="lblSubtitulo" styleClass="texto-suave" wrapText="true"
               text="Las categorías agrupan los postres del catálogo (por ejemplo Pastel o Gelatina)."/>
    </VBox>

    <HBox spacing="14">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label styleClass="formulario-etiqueta" text="Nombre *" contentDisplay="RIGHT" graphicTextGap="6" minWidth="-Infinity">
<graphic><IconoAyuda texto="Tipo de postre que agrupa productos y características, por ejemplo Pastel o Gelatina."/></graphic></Label>
            <ComboBox fx:id="cmbNombre" styleClass="combo-carmir" editable="true" maxWidth="Infinity" promptText="Ej. Pastel, Gelatina"/>
            <Label fx:id="lblVista3d" styleClass="texto-ayuda" wrapText="true" maxWidth="Infinity" minHeight="-Infinity">
                <graphic><FontIcon iconLiteral="bi-box"/></graphic>
            </Label>
        </VBox>
        <VBox spacing="4" prefWidth="150">
            <Label styleClass="formulario-etiqueta" text="Estado" contentDisplay="RIGHT" graphicTextGap="6" minWidth="-Infinity">
<graphic><IconoAyuda texto="Una categoría inactiva deja de ofrecerse, pero conserva su historial."/></graphic></Label>
            <ComboBox fx:id="cmbEstado" styleClass="combo-carmir" maxWidth="Infinity"/>
        </VBox>
    </HBox>

    <VBox spacing="4">
        <Label styleClass="formulario-etiqueta" text="Descripción"/>
        <TextArea fx:id="txtDescripcion" styleClass="campo" prefRowCount="3" wrapText="true"
                  promptText="Explicación breve para el cliente (máximo 255 caracteres)"/>
    </VBox>

    <Label fx:id="lblMensaje" styleClass="mensaje-error" maxWidth="Infinity" wrapText="true">
        <graphic><FontIcon iconLiteral="bi-exclamation-triangle-fill" iconColor="#c0392b"/></graphic>
    </Label>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancelar" styleClass="btn-oscuro" cancelButton="true" onAction="#onCancelar">
            <graphic><FontIcon iconLiteral="bi-x"/></graphic>
        </Button>
        <Button fx:id="btnGuardar" text="Guardar" styleClass="btn-verde" defaultButton="true" onAction="#onGuardar">
            <graphic><FontIcon iconLiteral="bi-check"/></graphic>
        </Button>
    </HBox>
</VBox>
