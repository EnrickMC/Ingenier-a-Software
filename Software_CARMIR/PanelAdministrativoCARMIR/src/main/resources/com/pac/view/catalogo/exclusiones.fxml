<?xml version="1.0" encoding="UTF-8"?>

<?import com.pac.modulos.pedidos.controller.BarraEstados?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Pestaña Exclusiones: pares de opciones que no se pueden elegir juntas -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pac.modulos.catalogo.controller.ExclusionesController"
      stylesheets="@../../css/pedidos.css"
      styleClass="pestana-contenido" spacing="16">

    <VBox styleClass="tarjeta" spacing="10">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label styleClass="formulario-etiqueta" text="Categoría"/>
            <ComboBox fx:id="cmbCategoria" styleClass="combo-carmir" prefWidth="220" onAction="#onCambioCategoria"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
        <!-- Botones de estado: debajo del selector de categoría -->
        <BarraEstados fx:id="barraEstados" compacto="true"/>
    </VBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox styleClass="tarjeta" spacing="12" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="tarjeta-titulo" text="Combinaciones no permitidas"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblConteo" styleClass="texto-suave"/>
            </HBox>
            <TableView fx:id="tblExclusiones" styleClass="tabla-carmir" VBox.vgrow="ALWAYS" minHeight="240"
                       onMouseClicked="#onSeleccion" onKeyReleased="#onSeleccion">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <columns>
                    <TableColumn text="Opción" minWidth="160" prefWidth="160">
                        <cellValueFactory><PropertyValueFactory property="opcionA"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="No se combina con" minWidth="160" prefWidth="160">
                        <cellValueFactory><PropertyValueFactory property="opcionB"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Estado" minWidth="70" prefWidth="70">
                        <cellValueFactory><PropertyValueFactory property="estado"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Motivo" minWidth="220" prefWidth="220">
                        <cellValueFactory><PropertyValueFactory property="motivo"/></cellValueFactory>
                    </TableColumn>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="12">
                        <Label fx:id="lblVacio" styleClass="tabla-vacia" text="Elige una categoría"/>
                    </VBox>
                </placeholder>
            </TableView>
            <HBox fx:id="cajaAcciones" spacing="10">
                <Button fx:id="btnCambiarEstado" text="Activar / inactivar" styleClass="btn-azul" onAction="#onCambiarEstado">
                    <graphic><FontIcon iconLiteral="bi-toggle-on"/></graphic>
                </Button>
                <Button fx:id="btnEliminar" text="Eliminar exclusión" styleClass="btn-rojo" onAction="#onEliminar">
                    <graphic><FontIcon iconLiteral="bi-trash-fill"/></graphic>
                </Button>
            </HBox>
        </VBox>

        <!-- ===== Alta de una exclusión ===== -->
        <VBox fx:id="cajaAlta" styleClass="tarjeta, tarjeta-detalle" spacing="10" minWidth="300" prefWidth="300" maxWidth="300">
            <Label styleClass="tarjeta-titulo" text="Nueva exclusión"/>
            <Label styleClass="texto-ayuda" wrapText="true"
                   text="Mientras esté activa, el cliente no podrá elegir juntas las dos opciones (por ejemplo, tres leches con frambuesa)."/>
            <Label styleClass="formulario-etiqueta" text="Opción *"/>
            <ComboBox fx:id="cmbOpcionA" styleClass="combo-carmir" maxWidth="Infinity" onAction="#onCambioOpcionA"/>
            <Label styleClass="formulario-etiqueta" text="No se puede combinar con *"/>
            <ComboBox fx:id="cmbOpcionB" styleClass="combo-carmir" maxWidth="Infinity"/>
            <Label styleClass="formulario-etiqueta" text="Motivo *"/>
            <TextArea fx:id="txtMotivo" styleClass="campo" prefRowCount="3" wrapText="true"
                      promptText="Por qué no se pueden combinar"/>
            <Label styleClass="formulario-etiqueta" text="Estado"/>
            <ComboBox fx:id="cmbEstado" styleClass="combo-carmir" maxWidth="Infinity"/>
            <Label fx:id="lblMensaje" styleClass="mensaje-error" maxWidth="Infinity" wrapText="true"/>
            <Region VBox.vgrow="ALWAYS"/>
            <HBox spacing="8">
                <Button text="Cancelar" styleClass="btn-oscuro" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onCancelar">
                    <graphic><FontIcon iconLiteral="bi-x"/></graphic>
                </Button>
                <Button text="Guardar" styleClass="btn-verde" HBox.hgrow="ALWAYS" maxWidth="Infinity" onAction="#onGuardar">
                    <graphic><FontIcon iconLiteral="bi-check"/></graphic>
                </Button>
            </HBox>
        </VBox>
    </HBox>
</VBox>
