<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Cancelación (RF-39) o baja de una solicitud: motivo y, si hay pagos, el reembolso -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pac.modulos.pedidos.controller.FormularioMotivoController"
      stylesheets="@../../css/carmir-base.css, @../../css/usuarios.css, @../../css/catalogo.css, @../../css/inventario.css, @../../css/pedidos.css"
      styleClass="formulario" spacing="12" prefWidth="520">

    <VBox spacing="2">
        <Label fx:id="lblTitulo" styleClass="formulario-titulo"/>
        <Label fx:id="lblExplicacion" styleClass="texto-suave" wrapText="true"/>
    </VBox>

    <VBox styleClass="caja-info" spacing="4">
        <Label fx:id="lblResumen" wrapText="true"/>
    </VBox>

    <VBox spacing="4">
        <Label styleClass="formulario-etiqueta" text="Motivo *"/>
        <ComboBox fx:id="cmbMotivo" styleClass="combo-carmir" maxWidth="Infinity" promptText="Elige el motivo"
                  onAction="#onCambioMotivo"/>
    </VBox>
    <VBox spacing="4">
        <Label fx:id="lblDetalle" styleClass="formulario-etiqueta" text="Descripción"/>
        <TextArea fx:id="txtDetalle" styleClass="campo" prefRowCount="3" wrapText="true"
                  promptText="Opcional. Detalles del motivo"/>
    </VBox>

    <!-- Reembolso: solo si hay pagos validados -->
    <VBox fx:id="cajaReembolso" spacing="4">
        <Label fx:id="lblPagado" styleClass="aviso-amarillo" maxWidth="Infinity" wrapText="true">
            <graphic><FontIcon iconLiteral="bi-cash-stack"/></graphic>
        </Label>
        <GridPane hgap="12" vgap="4">
            <columnConstraints>
                <ColumnConstraints percentWidth="50"/>
                <ColumnConstraints percentWidth="50"/>
            </columnConstraints>
            <Label styleClass="formulario-etiqueta" text="Monto a reembolsar ($)" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <Label styleClass="formulario-etiqueta" text="Estado del reembolso" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            <TextField fx:id="txtReembolso" styleClass="campo" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <ComboBox fx:id="cmbEstadoReembolso" styleClass="combo-carmir" maxWidth="Infinity"
                      GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        </GridPane>
    </VBox>

    <Label fx:id="lblMensaje" styleClass="mensaje-error" maxWidth="Infinity" wrapText="true">
        <graphic><FontIcon iconLiteral="bi-exclamation-triangle-fill" iconColor="#c0392b"/></graphic>
    </Label>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnNo" styleClass="btn-oscuro" cancelButton="true" onAction="#onNo">
            <graphic><FontIcon iconLiteral="bi-arrow-left"/></graphic>
        </Button>
        <Button fx:id="btnConfirmar" styleClass="btn-rojo" onAction="#onConfirmar">
            <graphic><FontIcon iconLiteral="bi-x-octagon-fill"/></graphic>
        </Button>
    </HBox>
</VBox>
