<?xml version="1.0" encoding="UTF-8"?>

<?import com.pac.modulos.pedidos.controller.BarraEstados?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Módulo 4 · Validación de Pagos (RF-28, RF-29): pagos que subieron los clientes y su revisión -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pac.modulos.pedidos.controller.PagosController"
      stylesheets="@../../css/usuarios.css, @../../css/catalogo.css, @../../css/inventario.css, @../../css/pedidos.css"
      spacing="14">

    <VBox styleClass="tarjeta" spacing="10">
    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar" styleClass="campo, campo-busqueda" HBox.hgrow="ALWAYS" maxWidth="260"
                   promptText="Folio, cliente o referencia" onAction="#onBuscar"/>
        <Button text="Buscar" styleClass="btn-oscuro" onAction="#onBuscar">
            <graphic><FontIcon iconLiteral="bi-zoom-in"/></graphic>
        </Button>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Actualizar" styleClass="btn-azul" onAction="#onBuscar">
            <graphic><FontIcon iconLiteral="bi-arrow-clockwise"/></graphic>
        </Button>
    </HBox>
        <!-- Botones de estado: al pulsarlos filtran los pagos -->
        <BarraEstados fx:id="barraEstados"/>
    </VBox>

    <VBox styleClass="tarjeta" spacing="12" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="tarjeta-titulo" text="Pagos"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblConteo" styleClass="texto-suave"/>
        </HBox>
        <TableView fx:id="tblPagos" styleClass="tabla-carmir" VBox.vgrow="ALWAYS" minHeight="260"
                   onMouseClicked="#onClicTabla">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <columns>
                <TableColumn text="Pedido" minWidth="60" prefWidth="60">
                    <cellValueFactory><PropertyValueFactory property="folio"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Cliente" minWidth="150" prefWidth="150">
                    <cellValueFactory><PropertyValueFactory property="cliente"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Monto" minWidth="85" prefWidth="85">
                    <cellValueFactory><PropertyValueFactory property="monto"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Fecha" minWidth="115" prefWidth="115">
                    <cellValueFactory><PropertyValueFactory property="fecha"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Método" minWidth="90" prefWidth="90">
                    <cellValueFactory><PropertyValueFactory property="metodo"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Referencia" minWidth="100" prefWidth="100">
                    <cellValueFactory><PropertyValueFactory property="referencia"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Compr." minWidth="55" prefWidth="55">
                    <cellValueFactory><PropertyValueFactory property="comprobante"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Estado del pedido" minWidth="130" prefWidth="130">
                    <cellValueFactory><PropertyValueFactory property="pedido"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Revisó" minWidth="100" prefWidth="100">
                    <cellValueFactory><PropertyValueFactory property="usuario"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Estado del pago" minWidth="160" prefWidth="160">
                    <cellValueFactory><PropertyValueFactory property="estado"/></cellValueFactory>
                </TableColumn>
            </columns>
            <placeholder>
                <VBox alignment="CENTER" spacing="12">
                    <Label fx:id="lblVacio" styleClass="tabla-vacia" text="No hay pagos por validar"/>
                </VBox>
            </placeholder>
        </TableView>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnComprobante" text="Abrir comprobante" styleClass="btn-oscuro" onAction="#onAbrirComprobante">
                <graphic><FontIcon iconLiteral="bi-box-arrow-up-right"/></graphic>
            </Button>
            <Button fx:id="btnVerPedido" text="Ver pedido" styleClass="btn-azul" onAction="#onVerPedido">
                <graphic><FontIcon iconLiteral="bi-basket-fill"/></graphic>
            </Button>
            <Button fx:id="btnValidar" text="Validar o rechazar" styleClass="btn-verde" onAction="#onValidar">
                <graphic><FontIcon iconLiteral="bi-check2-circle"/></graphic>
            </Button>
        </HBox>
    </VBox>
</VBox>
