<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Pestaña Historial de cambios: quién cambió qué parámetro y cuándo -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pac.modulos.configuracion.controller.HistorialController"
      styleClass="pestana-contenido" spacing="16">

    <VBox styleClass="tarjeta" spacing="10" VBox.vgrow="ALWAYS">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label styleClass="tarjeta-titulo" text="Historial de cambios">
                <graphic><FontIcon iconLiteral="bi-clock-history"/></graphic>
            </Label>
            <Label fx:id="lblConteo" styleClass="texto-suave"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Actualizar" styleClass="btn-azul" onAction="#onActualizar">
                <graphic><FontIcon iconLiteral="bi-arrow-clockwise"/></graphic>
            </Button>
        </HBox>
        <Label fx:id="lblError" styleClass="mensaje-error" maxWidth="Infinity" wrapText="true">
            <graphic><FontIcon iconLiteral="bi-x-circle-fill"/></graphic>
        </Label>
        <TableView fx:id="tblHistorial" styleClass="tabla-carmir" VBox.vgrow="ALWAYS" minHeight="320">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <columns>
                <TableColumn text="Fecha" minWidth="130" prefWidth="130">
                    <cellValueFactory><PropertyValueFactory property="fecha"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Usuario" minWidth="150" prefWidth="150">
                    <cellValueFactory><PropertyValueFactory property="usuario"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Parámetro" minWidth="170" prefWidth="170">
                    <cellValueFactory><PropertyValueFactory property="parametro"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Valor anterior" minWidth="150" prefWidth="150">
                    <cellValueFactory><PropertyValueFactory property="anterior"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Valor nuevo" minWidth="150" prefWidth="150">
                    <cellValueFactory><PropertyValueFactory property="nuevo"/></cellValueFactory>
                </TableColumn>
            </columns>
            <placeholder>
                <Label styleClass="tabla-vacia" text="Todavía no hay cambios registrados"/>
            </placeholder>
        </TableView>
    </VBox>
</VBox>
