<?xml version="1.0" encoding="UTF-8"?>

<?import com.pac.modulos.pedidos.controller.BarraEstados?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Módulo 7 · Gestión de Usuarios: lista del personal, filtro, detalle y acciones -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pac.modulos.usuarios.controller.UsuariosController"
      stylesheets="@../../css/usuarios.css, @../../css/pedidos.css" spacing="20">

    <!-- ===== Barra de búsqueda y botón de alta ===== -->
    <VBox styleClass="tarjeta" spacing="10">
        <HBox spacing="12" alignment="CENTER_LEFT">
            <TextField fx:id="txtBuscar" styleClass="campo, campo-busqueda" HBox.hgrow="ALWAYS" minWidth="200" maxWidth="360"
                       promptText="Buscar por nombre o usuario" onAction="#onBuscar"/>
            <Button text="Buscar" minWidth="-Infinity" styleClass="btn-oscuro" onAction="#onBuscar">
                <graphic><FontIcon iconLiteral="bi-zoom-in"/></graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Nuevo usuario" minWidth="-Infinity" styleClass="btn-verde" onAction="#onNuevo">
                <graphic><FontIcon iconLiteral="bi-person-plus-fill"/></graphic>
            </Button>
        </HBox>
        <!-- Botones de estado: debajo del campo de búsqueda -->
        <BarraEstados fx:id="barraEstados" compacto="true"/>
    </VBox>

    <HBox spacing="20" VBox.vgrow="ALWAYS">

        <!-- ===== Lista de usuarios ===== -->
        <VBox styleClass="tarjeta" spacing="14" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="tarjeta-titulo" text="Personal registrado"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblConteo" styleClass="texto-suave" text=""/>
            </HBox>

            <TableView fx:id="tblUsuarios" styleClass="tabla-carmir" VBox.vgrow="ALWAYS" minHeight="300"
                       onMouseClicked="#onClicTabla" onKeyReleased="#onTeclaTabla">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <columns>
                    <TableColumn text="Nombre completo" minWidth="150" prefWidth="150">
                        <cellValueFactory><PropertyValueFactory property="nombreCompleto"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Usuario" minWidth="95" prefWidth="95">
                        <cellValueFactory><PropertyValueFactory property="nombreUsuario"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Estado" minWidth="80" prefWidth="80">
                        <cellValueFactory><PropertyValueFactory property="estado"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Último acceso" minWidth="120" prefWidth="120">
                        <cellValueFactory><PropertyValueFactory property="ultimoAcceso"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Permisos" minWidth="220" prefWidth="220">
                        <cellValueFactory><PropertyValueFactory property="permisos"/></cellValueFactory>
                    </TableColumn>
                </columns>
                <!-- Lo que se ve cuando la tabla está vacía -->
                <placeholder>
                    <VBox alignment="CENTER" spacing="12">
                        <Label fx:id="lblVacio" styleClass="tabla-vacia" text="Cargando usuarios..."/>
                    </VBox>
                </placeholder>
            </TableView>
        </VBox>

        <!-- ===== Detalle del usuario seleccionado ===== -->
        <VBox styleClass="tarjeta, tarjeta-detalle" spacing="14" minWidth="290" prefWidth="290" maxWidth="290">
            <Label styleClass="tarjeta-titulo" text="Detalle"/>

            <!-- Cuando no hay nadie seleccionado -->
            <VBox fx:id="cajaSinSeleccion" alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
                <FontIcon iconLiteral="bi-person-badge-fill" styleClass="detalle-icono-vacio"/>
                <Label styleClass="texto-suave" wrapText="true" textAlignment="CENTER"
                       text="Selecciona un usuario de la lista para ver su información"/>
            </VBox>

            <!-- Datos del usuario (nunca la contraseña) -->
            <VBox fx:id="cajaDetalle" spacing="14" VBox.vgrow="ALWAYS">
                <VBox spacing="2">
                    <Label fx:id="lblDetNombre" styleClass="detalle-nombre" wrapText="true" text="Nombre"/>
                    <Label fx:id="lblDetUsuario" styleClass="texto-suave" text="@usuario"/>
                </VBox>

                <GridPane hgap="10" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="115"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <Label styleClass="detalle-etiqueta" text="Estado" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <Label fx:id="lblDetEstado" styleClass="estado-chip" text="Activo" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                    <Label styleClass="detalle-etiqueta" text="Último acceso" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <Label fx:id="lblDetUltimoAcceso" text="Nunca" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                    <Label styleClass="detalle-etiqueta" text="Intentos fallidos" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Label fx:id="lblDetIntentos" text="0" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                </GridPane>

                <Separator/>
                <Label styleClass="detalle-etiqueta" text="Permisos asignados"/>
                <VBox fx:id="listaDetPermisos" spacing="6"/>

                <Region VBox.vgrow="ALWAYS"/>
                <VBox spacing="8">
                    <Button text="Modificar usuario" styleClass="btn-azul" maxWidth="Infinity" onAction="#onEditar">
                        <graphic><FontIcon iconLiteral="bi-pencil-square"/></graphic>
                    </Button>
                    <Button fx:id="btnDarDeBaja" text="Dar de baja" styleClass="btn-rojo" maxWidth="Infinity"
                            onAction="#onDarDeBaja">
                        <graphic><FontIcon iconLiteral="bi-person-x-fill"/></graphic>
                    </Button>
                </VBox>
            </VBox>
        </VBox>
    </HBox>
</VBox>
