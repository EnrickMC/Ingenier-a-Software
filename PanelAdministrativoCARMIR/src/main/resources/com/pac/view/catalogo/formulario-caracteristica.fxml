<?xml version="1.0" encoding="UTF-8"?>

<?import com.pac.util.IconoAyuda?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Ventana para registrar o modificar una característica de una categoría -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pac.modulos.catalogo.controller.FormularioCaracteristicaController"
      stylesheets="@../../css/carmir-base.css, @../../css/usuarios.css, @../../css/catalogo.css"
      styleClass="formulario" spacing="12" prefWidth="540">

    <fx:define>
        <ToggleGroup fx:id="grupoSeleccion"/>
    </fx:define>

    <VBox spacing="2">
        <Label fx:id="lblTitulo" styleClass="formulario-titulo" text="Nueva característica"/>
        <Label fx:id="lblCategoria" styleClass="texto-suave" wrapText="true"/>
    </VBox>

    <HBox spacing="14">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label styleClass="formulario-etiqueta" text="Nombre *" contentDisplay="RIGHT" graphicTextGap="6" minWidth="-Infinity">
<graphic><IconoAyuda texto="Nombre de la característica que ve el cliente al personalizar su postre, por ejemplo Sabor, Tamaño o Decoración."/></graphic></Label>
            <ComboBox fx:id="cmbNombre" styleClass="combo-carmir" editable="true" maxWidth="Infinity" promptText="Ej. Sabor, Tamaño, Decoración"/>
        </VBox>
        <VBox spacing="4" prefWidth="130">
            <Label styleClass="formulario-etiqueta" text="Orden de muestra *" contentDisplay="RIGHT" graphicTextGap="6" minWidth="-Infinity">
<graphic><IconoAyuda texto="Posición en la que aparece la característica al personalizar. 1 es la primera que ve el cliente."/></graphic></Label>
            <TextField fx:id="txtOrden" styleClass="campo" promptText="1"/>
        </VBox>
    </HBox>

    <VBox spacing="4">
        <Label styleClass="formulario-etiqueta" text="Descripción"/>
        <TextArea fx:id="txtDescripcion" styleClass="campo" prefRowCount="2" wrapText="true"
                  promptText="Explicación para el cliente o el personal"/>
    </VBox>

    <VBox spacing="6" styleClass="caja-permisos">
        <Label styleClass="formulario-etiqueta" text="¿Cómo elige el cliente?" contentDisplay="RIGHT" graphicTextGap="6" minWidth="-Infinity">
<graphic><IconoAyuda texto="Única: el cliente elige solo una opción (ej. Sabor). Múltiple: puede elegir varias, limitadas por el presupuesto de puntos."/></graphic></Label>
        <HBox spacing="20">
            <RadioButton fx:id="rbUnica" text="Selección única (solo una opción, ej. Sabor)"
                         toggleGroup="$grupoSeleccion" onAction="#onCambioSeleccion"/>
            <RadioButton fx:id="rbMultiple" text="Selección múltiple"
                         toggleGroup="$grupoSeleccion" onAction="#onCambioSeleccion"/>
        </HBox>
        <HBox fx:id="cajaPresupuesto" spacing="10" alignment="CENTER_LEFT">
            <Label styleClass="formulario-etiqueta" text="Presupuesto de selección *" contentDisplay="RIGHT" graphicTextGap="6" minWidth="-Infinity">
<graphic><IconoAyuda texto="Puntos que el cliente puede gastar entre las opciones elegidas. Cada opción gasta sus propios puntos de selección."/></graphic></Label>
            <TextField fx:id="txtPresupuesto" styleClass="campo" prefWidth="90" promptText="3"/>
            <Label styleClass="texto-suave" text="puntos"/>
        </HBox>
        <Label fx:id="lblAyudaPresupuesto" styleClass="texto-ayuda" wrapText="true"
               text="El presupuesto son los puntos que pueden gastar las opciones elegidas. Ejemplo: Decoración con presupuesto 3, moño = 1 punto y listón = 2 puntos: caben tres moños, o un moño y un listón. Un tamaño grande puede ampliar el presupuesto con su multiplicador."/>
    </VBox>

    <HBox spacing="24">
        <CheckBox fx:id="chkObligatoria" text="Obligatoria (debe elegir al menos una opción)"/>
        <CheckBox fx:id="chkDisponible" text="Disponible" selected="true"/>
    </HBox>
    <CheckBox fx:id="chkPermiteReceta" text="Sus opciones pueden tener receta" selected="true"/>

    <Label fx:id="lblMensaje" styleClass="mensaje-error" maxWidth="Infinity" wrapText="true">
        <graphic><FontIcon iconLiteral="bi-exclamation-triangle-fill" iconColor="#c0392b"/></graphic>
    </Label>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancelar" styleClass="btn-oscuro" cancelButton="true" onAction="#onCancelar">
            <graphic><FontIcon iconLiteral="bi-x"/></graphic>
        </Button>
        <Button fx:id="btnGuardar" text="Guardar" styleClass="btn-verde" defaultButton="true" onAction="#onGuardar">
            <graphic><FontIcon iconLiteral="bi-check"/></graphic>
        </Button>
    </HBox>
</VBox>
