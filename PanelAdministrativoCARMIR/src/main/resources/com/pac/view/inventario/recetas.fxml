<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Módulo 5 · Recetas (RF-55 a RF-58): una receta por opción del catálogo -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pac.modulos.inventario.controller.RecetasController"
      stylesheets="@../../css/usuarios.css, @../../css/catalogo.css, @../../css/inventario.css" spacing="14">

    <!-- Aviso para el personal que solo consulta las recetas -->
    <Label fx:id="lblModoConsulta" styleClass="aviso-consulta" maxWidth="Infinity" wrapText="true"
           text="Modo consulta: solo la administradora registra, modifica o da de baja recetas.">
        <graphic><FontIcon iconLiteral="bi-eye-fill"/></graphic>
    </Label>

    <HBox styleClass="tarjeta" spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtBuscar" styleClass="campo, campo-busqueda" HBox.hgrow="ALWAYS" maxWidth="280"
                   promptText="Buscar por receta, opción o categoría" onAction="#onBuscar"/>
        <CheckBox fx:id="chkInactivas" minWidth="-Infinity" styleClass="casilla-filtro" text="Ver dadas de baja" onAction="#onBuscar"/>
        <Button text="Buscar" minWidth="-Infinity" styleClass="btn-oscuro" onAction="#onBuscar">
            <graphic><FontIcon iconLiteral="bi-zoom-in"/></graphic>
        </Button>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnNueva" text="Registrar receta" minWidth="-Infinity" styleClass="btn-verde" onAction="#onNueva">
            <graphic><FontIcon iconLiteral="bi-plus-circle-fill"/></graphic>
        </Button>
    </HBox>

    <HBox spacing="16" VBox.vgrow="ALWAYS">
        <VBox styleClass="tarjeta" spacing="12" HBox.hgrow="ALWAYS">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label styleClass="tarjeta-titulo" text="Recetas por opción del catálogo"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblConteo" styleClass="texto-suave"/>
            </HBox>
            <Label fx:id="lblAviso" styleClass="aviso-amarillo" maxWidth="Infinity" wrapText="true">
                <graphic><FontIcon iconLiteral="bi-exclamation-triangle-fill"/></graphic>
            </Label>
            <TableView fx:id="tblRecetas" styleClass="tabla-carmir" VBox.vgrow="ALWAYS" minHeight="260"
                       onMouseClicked="#onClicTabla" onKeyReleased="#onClicTabla">
                <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                <columns>
                    <TableColumn text="Receta" minWidth="150" prefWidth="150">
                        <cellValueFactory><PropertyValueFactory property="nombre"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Opción del catálogo" minWidth="190" prefWidth="190">
                        <cellValueFactory><PropertyValueFactory property="opcion"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Tiempo" minWidth="60" prefWidth="60">
                        <cellValueFactory><PropertyValueFactory property="tiempo"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Costo" minWidth="75" prefWidth="75">
                        <cellValueFactory><PropertyValueFactory property="costo"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Precio base" minWidth="80" prefWidth="80">
                        <cellValueFactory><PropertyValueFactory property="precio"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Estado" minWidth="110" prefWidth="110">
                        <cellValueFactory><PropertyValueFactory property="estado"/></cellValueFactory>
                    </TableColumn>
                </columns>
                <placeholder>
                    <VBox alignment="CENTER" spacing="12">
                        <Label fx:id="lblVacio" styleClass="tabla-vacia" text="Aún no hay recetas registradas"/>
                    </VBox>
                </placeholder>
            </TableView>
            <HBox spacing="14" alignment="CENTER_LEFT">
                <Label styleClass="chip, chip-proximo" text="Requiere revisión (tiene insumos dados de baja)"/>
                <Label styleClass="chip, chip-gris" text="Dada de baja"/>
            </HBox>
        </VBox>

        <!-- Detalle pensado para leerse en cocina: letra grande -->
        <VBox styleClass="tarjeta, tarjeta-detalle" spacing="10" minWidth="400" prefWidth="420" maxWidth="460">
            <VBox fx:id="cajaSinSeleccion" alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
                <FontIcon iconLiteral="bi-journal-bookmark-fill" styleClass="detalle-icono-vacio"/>
                <Label styleClass="texto-suave" wrapText="true" textAlignment="CENTER"
                       text="Selecciona una receta para ver sus ingredientes y pasos de preparación"/>
            </VBox>
            <ScrollPane fx:id="cajaDetalle" fitToWidth="true" styleClass="scroll-detalle" VBox.vgrow="ALWAYS">
                <VBox spacing="10">
                    <Label fx:id="lblDetNombre" styleClass="receta-titulo" wrapText="true"/>
                    <Label fx:id="lblDetOpcion" styleClass="receta-subtitulo" wrapText="true"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label fx:id="lblDetEstado" styleClass="chip"/>
                        <Label fx:id="lblDetTiempo" styleClass="chip, chip-info">
                            <graphic><FontIcon iconLiteral="bi-clock-fill"/></graphic>
                        </Label>
                    </HBox>
                    <Label fx:id="lblDetAviso" styleClass="aviso-amarillo" maxWidth="Infinity" wrapText="true">
                        <graphic><FontIcon iconLiteral="bi-exclamation-triangle-fill"/></graphic>
                    </Label>
                    <Label fx:id="lblDetCosto" wrapText="true"/>
                    <Separator/>
                    <Label styleClass="receta-seccion" text="Ingredientes"/>
                    <VBox fx:id="listaIngredientes" spacing="6"/>
                    <Separator/>
                    <Label styleClass="receta-seccion" text="Preparación"/>
                    <VBox styleClass="caja-pasos">
                        <Label fx:id="lblDetPasos" styleClass="receta-pasos" wrapText="true"/>
                    </VBox>
                </VBox>
            </ScrollPane>
            <HBox fx:id="cajaBotones" spacing="8">
                <Button fx:id="btnModificar" text="Modificar receta" styleClass="btn-azul" HBox.hgrow="ALWAYS"
                        maxWidth="Infinity" onAction="#onModificar">
                    <graphic><FontIcon iconLiteral="bi-pencil-square"/></graphic>
                </Button>
                <Button fx:id="btnDarDeBaja" text="Dar de baja" styleClass="btn-rojo" HBox.hgrow="ALWAYS"
                        maxWidth="Infinity" onAction="#onDarDeBaja">
                    <graphic><FontIcon iconLiteral="bi-trash-fill"/></graphic>
                </Button>
                <Button fx:id="btnReactivar" text="Registrar de nuevo" styleClass="btn-verde" HBox.hgrow="ALWAYS"
                        maxWidth="Infinity" onAction="#onReactivar">
                    <graphic><FontIcon iconLiteral="bi-arrow-counterclockwise"/></graphic>
                </Button>
            </HBox>
        </VBox>
    </HBox>
</VBox>
