<?xml version="1.0" encoding="UTF-8"?>

<?import com.pac.util.IconoAyuda?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<!-- Ventana para registrar (RF-42) o modificar (RF-43) una receta -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.pac.modulos.inventario.controller.FormularioRecetaController"
      stylesheets="@../../css/carmir-base.css, @../../css/usuarios.css, @../../css/catalogo.css, @../../css/inventario.css"
      styleClass="formulario" spacing="12" prefWidth="720">

    <VBox spacing="2">
        <Label fx:id="lblTitulo" styleClass="formulario-titulo" text="Registrar receta"/>
        <Label styleClass="texto-suave" wrapText="true"
               text="Cada opción del catálogo tiene una sola receta. Su costo da el precio de la opción y sus cantidades se descuentan del inventario al preparar un pedido."/>
    </VBox>

    <VBox spacing="4">
        <Label styleClass="formulario-etiqueta" text="Opción del catálogo *" contentDisplay="RIGHT" graphicTextGap="6" minWidth="-Infinity">
<graphic><IconoAyuda texto="Opción de personalización a la que pertenece esta receta. Solo puede haber una receta por opción."/></graphic></Label>
        <ComboBox fx:id="cmbOpcion" styleClass="combo-carmir" maxWidth="Infinity"
                  promptText="Elige la opción que prepara esta receta" onAction="#onCambioOpcion"/>
        <Label fx:id="lblOpcionFija" styleClass="receta-subtitulo" wrapText="true"/>
    </VBox>

    <GridPane hgap="12" vgap="4">
        <columnConstraints>
            <ColumnConstraints percentWidth="70"/>
            <ColumnConstraints percentWidth="30"/>
        </columnConstraints>
        <Label styleClass="formulario-etiqueta" text="Nombre de la receta *" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label styleClass="formulario-etiqueta" text="Tiempo (minutos) *" GridPane.rowIndex="0" GridPane.columnIndex="1" contentDisplay="RIGHT" graphicTextGap="6" minWidth="-Infinity">
<graphic><IconoAyuda texto="Tiempo estimado de preparación. Ayuda a planear la agenda de producción."/></graphic></Label>
        <TextField fx:id="txtNombre" styleClass="campo" promptText="Ej. Bizcocho de chocolate"
                   GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtTiempo" styleClass="campo" promptText="Ej. 45" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    </GridPane>

    <!-- Ingredientes -->
    <VBox spacing="6">
        <Label styleClass="formulario-etiqueta" text="Ingredientes *" contentDisplay="RIGHT" graphicTextGap="6" minWidth="-Infinity">
<graphic><IconoAyuda texto="Insumos y cantidades necesarias. Estas cantidades se descuentan automáticamente al preparar un pedido."/></graphic></Label>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <ComboBox fx:id="cmbInsumo" styleClass="combo-carmir" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                      promptText="Insumo" onAction="#onCambioInsumo"/>
            <TextField fx:id="txtCantidad" styleClass="campo" prefWidth="110" promptText="Cantidad" onAction="#onAgregar"/>
            <Label fx:id="lblUnidad" styleClass="texto-suave" minWidth="40"/>
            <Button text="Agregar" styleClass="btn-oscuro" onAction="#onAgregar">
                <graphic><FontIcon iconLiteral="bi-plus"/></graphic>
            </Button>
        </HBox>
        <Label styleClass="texto-ayuda" wrapText="true"
               text="Si agregas un insumo que ya está en la lista, se cambia su cantidad. Las cantidades son por una unidad de la opción."/>
        <TableView fx:id="tblIngredientes" styleClass="tabla-carmir" prefHeight="170" minHeight="140"
                   onMouseClicked="#onClicIngrediente">
            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
            <columns>
                <TableColumn text="Insumo" minWidth="280" prefWidth="280">
                    <cellValueFactory><PropertyValueFactory property="insumo"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Cantidad" minWidth="120" prefWidth="120">
                    <cellValueFactory><PropertyValueFactory property="cantidad"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Costo" minWidth="100" prefWidth="100">
                    <cellValueFactory><PropertyValueFactory property="costo"/></cellValueFactory>
                </TableColumn>
            </columns>
            <placeholder>
                <Label styleClass="tabla-vacia" text="Agrega al menos un insumo"/>
            </placeholder>
        </TableView>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <Button fx:id="btnQuitar" text="Quitar seleccionado" styleClass="btn-secundario, peligro" onAction="#onQuitar">
                <graphic><FontIcon iconLiteral="bi-dash-circle-fill"/></graphic>
            </Button>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT" spacing="2">
                <Label fx:id="lblCosto" styleClass="costo-vivo" text="Costo: $0.00"/>
                <Label fx:id="lblPrecio" styleClass="texto-suave"/>
            </VBox>
        </HBox>
    </VBox>

    <VBox spacing="4">
        <Label styleClass="formulario-etiqueta" text="Pasos de preparación *"/>
        <TextArea fx:id="txtPasos" styleClass="campo" prefRowCount="6" wrapText="true"
                  promptText="1. Precalentar el horno a 180 °C&#10;2. ..."/>
    </VBox>

    <Label fx:id="lblMensaje" styleClass="mensaje-error" maxWidth="Infinity" wrapText="true">
        <graphic><FontIcon iconLiteral="bi-exclamation-triangle-fill" iconColor="#c0392b"/></graphic>
    </Label>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancelar" styleClass="btn-oscuro" cancelButton="true" onAction="#onCancelar">
            <graphic><FontIcon iconLiteral="bi-x"/></graphic>
        </Button>
        <Button fx:id="btnGuardar" text="Guardar receta" styleClass="btn-verde" onAction="#onGuardar">
            <graphic><FontIcon iconLiteral="bi-check"/></graphic>
        </Button>
    </HBox>
</VBox>
